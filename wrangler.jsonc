{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Next.js 静态导出 (out/) 作为 Worker 静态资源托管
  "name": "zanemono-home",
  "compatibility_date": "2026-11-01",
  // 账号 ID 不是凭据，可以公开；部署凭据是 CI 里的 CLOUDFLARE_API_TOKEN secret
  "account_id": "9058afdde156444e8e507c322b4ccc4d",
  // 只负责给 /media/ 下的视频补 Range(206) 支持，其余请求不经过脚本
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  // custom_domain 用主机名 zanemono.com（不是 zanemono.com/*）
  "routes": [
    { "pattern": "zanemono.com", "custom_domain": true }
  ]
}
